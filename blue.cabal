cabal-version:      3.0
name:               blue
version:            0.1.0.0
synopsis:           The Blue Machine
description:
    A SECD Lisp machine: reference machine, reference evaluator, and
    Lisp-to-SECD compiler in Haskell; the same machine as a circuit in
    Clash, targeting a Basys 3 (Artix-7 35T) with VGA and keyboard.
    See PROJECT.md.

homepage:           https://blue-lang.or
license:            GPL-3.0-only
license-file:       LICENSE
author:             Isaac Hiram Lopez Diaz
maintainer:         isaac@ih1d.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md, PROJECT.md, README.md
extra-source-files: lisp/*.lisp, hw/*.xdc
tested-with:        GHC == 9.10.3

-- Hardware is off by default: clash-ghc drags in a large dependency
-- tree and is only needed from M2 onwards.  Enable with
--   cabal build -f hardware all
flag hardware
    description: Build the Clash circuit (Build 5, M2-M6).
    default:     False
    manual:      True

flag werror
    description: Turn warnings into errors (CI).
    default:     False
    manual:      True

----------------------------------------------------------------------
-- Shared option blocks
----------------------------------------------------------------------

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-deriving-strategies
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages
        -fshow-warning-groups

    if flag(werror)
        ghc-options: -Werror

-- The reference machine runs generated programs by the thousand under
-- Hedgehog; it is worth compiling properly.
common optimized
    ghc-options:
        -O2
        -funbox-strict-fields

-- Clash can only synthesize code whose unfoldings it can see, and the
-- worker/wrapper transform hides them.  Any module the circuit reaches
-- into needs these two flags, Clash-using or not.
common synthesizable
    ghc-options:
        -fexpose-all-unfoldings
        -fno-worker-wrapper

-- Plus the type-level solvers for the size arithmetic in Clash.Prelude.
common clash-opts
    import: synthesizable
    ghc-options:
        -fplugin=GHC.TypeLits.Extra.Solver
        -fplugin=GHC.TypeLits.KnownNat.Solver
        -fplugin=GHC.TypeLits.Normalise
        -Wno-unticked-promoted-constructors

    build-depends:
        , clash-prelude              >=1.10 && <1.12
        , ghc-typelits-extra         >=0.5  && <0.6
        , ghc-typelits-knownnat      >=0.8  && <0.9
        , ghc-typelits-natnormalise  >=0.9  && <0.10

    default-extensions:
        BinaryLiterals
        DataKinds
        DeriveAnyClass
        DerivingStrategies
        ExplicitNamespaces
        MagicHash
        NoImplicitPrelude
        NoStarIsType
        NoStrictData
        QuasiQuotes
        TemplateHaskell
        TypeFamilies

    default-language: GHC2021

----------------------------------------------------------------------
-- blue:spec -- the ISA, shared by software and hardware
----------------------------------------------------------------------

-- Cell layout, tag encoding and opcode numbering live here, alone, so
-- that Build 1 and Build 5 cannot disagree about them.  Depends on base
-- only: the circuit inlines these definitions, so nothing here may
-- reach for a library Clash cannot see through.
library spec
    import:           warnings, synthesizable
    visibility:       public
    hs-source-dirs:   spec
    exposed-modules:
        Blue.Spec.Cell
        Blue.Spec.Opcode

    build-depends:    base ^>=4.20.2.0
    default-language: GHC2024

----------------------------------------------------------------------
-- blue -- everything that runs on the laptop (Builds 1-4)
----------------------------------------------------------------------

library
    import:           warnings, optimized
    hs-source-dirs:   src
    exposed-modules:
        -- The dialect
        Blue.Syntax
        Blue.Reader
        Blue.Printer
        -- Build 2: the semantic oracle
        Blue.Eval
        -- Build 1: the reference SECD machine
        Blue.SECD.Code
        Blue.SECD.Heap
        Blue.SECD.Machine
        Blue.SECD.GC
        -- Build 3: the compiler
        Blue.Compile
        -- Build 4: ROM image and the M1 driver
        Blue.Image
        Blue.Console
        Blue.REPL

    build-depends:
        , base           ^>=4.20.2.0
        , blue:spec
        , bytestring     >=0.12 && <0.13
        , containers     >=0.7  && <0.9
        , megaparsec     >=9.6  && <9.9
        , mtl            >=2.3  && <2.4
        , prettyprinter  >=1.7  && <1.8
        , text           >=2.1  && <2.3
        , vector         >=0.13 && <0.14

    default-language: GHC2024
    default-extensions:
        LambdaCase
        OverloadedStrings
        StrictData

----------------------------------------------------------------------
-- blue-hw -- Build 5, the circuit
----------------------------------------------------------------------

library blue-hw
    import:           warnings, clash-opts
    visibility:       public
    hs-source-dirs:   hw
    -- Cell: bit-level encode/decode.  Heap: BRAM request/response
    -- timing.  SECD: the Mealy FSM, a port of Blue.SECD.Machine.
    -- GC: Cheney as an FSM mode (M5).  Font/VGA/Terminal/PS2: M3.
    -- Top: topEntity for the Basys 3 (M4).
    exposed-modules:
        Blue.HW.Cell
        Blue.HW.Heap
        Blue.HW.SECD
        Blue.HW.GC
        Blue.HW.Font
        Blue.HW.VGA
        Blue.HW.Terminal
        Blue.HW.PS2
        Blue.HW.Top

    build-depends:    base ^>=4.20.2.0, blue:spec

    if !flag(hardware)
        buildable: False

----------------------------------------------------------------------
-- Executables
----------------------------------------------------------------------

executable blue
    import:           warnings, optimized
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        , base                  ^>=4.20.2.0
        , blue
        , haskeline             >=0.8  && <0.9
        , optparse-applicative  >=0.18 && <0.20

    default-language: GHC2024
    default-extensions: LambdaCase, OverloadedStrings

-- `cabal run blue:clash -- Blue.HW.Top --verilog` generates HDL.
executable clash
    import:           warnings
    hs-source-dirs:   bin
    main-is:          Clash.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base ^>=4.20.2.0, clash-ghc >=1.10 && <1.12, blue:blue-hw
    default-language: GHC2021

    if !flag(hardware)
        buildable: False

-- `cabal run blue:clashi` opens the circuit in the Clash interpreter.
executable clashi
    import:           warnings
    hs-source-dirs:   bin
    main-is:          Clashi.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base ^>=4.20.2.0, clash-ghc >=1.10 && <1.12, blue:blue-hw
    default-language: GHC2021

    if !flag(hardware)
        buildable: False

----------------------------------------------------------------------
-- Tests
----------------------------------------------------------------------

-- The correctness story: interpret p == run (compile p), for programs
-- generated by Hedgehog.
test-suite blue-test
    import:           warnings, optimized
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        Test.Blue.Gen
        Test.Blue.Differential
        Test.Blue.Reader
        Test.Blue.GC

    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        , base            ^>=4.20.2.0
        , blue
        , hedgehog        >=1.5  && <1.8
        , tasty           >=1.5  && <1.6
        , tasty-hedgehog  >=1.4  && <1.5
        , tasty-hunit     >=0.10 && <0.11

    default-language: GHC2024
    default-extensions: LambdaCase, OverloadedStrings

-- Build 5 against Build 1: same programs, both machines, same answers.
test-suite blue-hw-test
    import:           warnings, clash-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   hw-test
    main-is:          Main.hs
    build-depends:
        , base            ^>=4.20.2.0
        , blue
        , blue:blue-hw
        , hedgehog        >=1.5 && <1.8
        , tasty           >=1.5 && <1.6
        , tasty-hedgehog  >=1.4 && <1.5

    if !flag(hardware)
        buildable: False
